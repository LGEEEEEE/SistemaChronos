<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login da Empresa - Chronos</title>
    <link rel="shortcut icon" href="/icon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; display: flex; flex-direction: column; min-height: 100vh; }
        .navbar-chronos { background-color: #2c3e50; }
        .login-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .login-card { max-width: 400px; width: 100%; border: none; border-radius: 12px; }
        .btn-rh { background-color: #2c3e50; border-color: #2c3e50; color: white; }
        .btn-rh:hover { background-color: #1a252f; color: white; }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark navbar-chronos shadow-sm">
        <div class="container justify-content-center">
            <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" href="/">
                <img src="/icon.ico" alt="Logo Chronos" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos <span class="badge bg-light text-dark ms-2 fs-6 shadow-sm">RH / ADMIN</span>
            </a>
        </div>
    </nav>

    <div class="login-wrapper">
        <div class="card login-card shadow-lg">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-1">Acesso da Empresa</h3>
                    <p class="text-muted">Gestão de equipe e relatórios</p>
                </div>

                <% if (locals.error) { %>
                    <div class="alert alert-danger p-3 mb-4 text-center fw-bold shadow-sm border-0" role="alert">
                        ⚠️ <%= error %>
                    </div>
                <% } %>

                <form action="/rh/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">E-mail de Administrador</label>
                        <input type="email" name="email" class="form-control form-control-lg bg-light" placeholder="rh@suaempresa.com" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">Senha</label>
                        <input type="password" name="senha" class="form-control form-control-lg bg-light" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-rh btn-lg w-100 fw-bold mb-3 shadow-sm">Acessar Painel</button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-1">É um colaborador?</p>
                    <a href="/login" class="text-decoration-none fw-bold small" style="color: #3498db;">Acesse a área de Bater Ponto</a>
                    <div class="mt-3">
                        <a href="/empresa/cadastrar" class="text-decoration-none fw-bold small text-secondary">Ainda não tem conta? Crie aqui</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>