<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard do RH - Chronos</title>
    <link rel="shortcut icon" href="/icon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; padding-bottom: 50px; }
        .navbar-chronos { background-color: #2c3e50; }
        .action-group { display: flex; gap: 5px; flex-wrap: wrap; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-chronos shadow-sm mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/rh/dashboard">
                <img src="/icon.ico" alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos <span class="badge bg-light text-dark ms-2 fs-6 shadow-sm">RH / ADMIN</span>
            </a>
            <div class="d-flex">
                <form action="/logout" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-light btn-sm fw-bold">Sair do Sistema</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold text-dark mb-1">Painel de Controle do RH</h2>
                <% const optionsData = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }; %>
                <% const dataHoje = new Date().toLocaleDateString('pt-BR', optionsData); %>
                <p class="text-muted mb-0 fs-5">Hoje é: <strong class="text-primary text-capitalize"><%= dataHoje %></strong></p>
            </div>
            <div>
                <a href="/cadastro" class="btn btn-success btn-lg fw-bold shadow-sm">+ Adicionar Funcionário</a>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4 p-2 bg-white">
            <div class="d-flex flex-wrap gap-2">
                <a href="/rh/dashboard" class="btn btn-primary fw-bold">Painel Principal</a>
                <a href="/rh/relatorios" class="btn btn-outline-secondary fw-bold">Relatório de Faltas</a>
                <a href="/rh/relatorios/folha-ponto" class="btn btn-outline-secondary fw-bold">Folha de Ponto Semanal</a>
                <a href="/rh/empresa" class="btn btn-outline-secondary fw-bold">Definições da Empresa</a>
                <a href="/dashboard" class="btn btn-warning fw-bold text-dark ms-auto">📷 Bater Meu Ponto</a>
            </div>
        </div>

        <% if (locals.query) { %>
            <% if (query.erro === 'auto_exclusao') { %>
                <div class="alert alert-danger fw-bold shadow-sm">⚠️ Operação bloqueada: Você não pode excluir a sua própria conta!</div>
            <% } %>
            <% if (query.msg === 'func_cadastrado') { %>
                <div class="alert alert-success fw-bold shadow-sm">✅ Funcionário cadastrado com sucesso!</div>
            <% } %>
            <% if (query.msg === 'func_editado') { %>
                <div class="alert alert-success fw-bold shadow-sm">✅ Dados atualizados com sucesso!</div>
            <% } %>
            <% if (query.msg === 'func_deletado') { %>
                <div class="alert alert-danger fw-bold shadow-sm">🗑️ Funcionário e os seus registros foram eliminados.</div>
            <% } %>
        <% } %>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0 bg-white">
                    <thead class="table-light text-secondary text-center">
                        <tr>
                            <th width="15%">Colaborador</th>
                            <th width="12%">Expediente Hoje</th>
                            <th width="20%">Registros Hoje</th>
                            <th width="10%">Total Horas</th>
                            <th width="15%">Definir Horário</th>
                            <th width="13%">Férias</th>
                            <th width="15%">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (usuarios && usuarios.length > 0) { %>
                            <% usuarios.forEach(usuario => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><%= usuario.nome %></div>
                                        <div class="text-muted small"><%= usuario.email %></div>
                                        <% if (usuario.role === 'rh') { %>
                                            <span class="badge bg-info text-dark mt-1">RH</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border fs-6"><%= expedientes[usuario.id].entrada %></span>
                                        <br><small>até</small><br>
                                        <span class="badge bg-light text-dark border fs-6"><%= expedientes[usuario.id].saida %></span>
                                    </td>
                                    <td>
                                        <% if (registros[usuario.id] && registros[usuario.id].length > 0) { %>
                                            <ul class="list-unstyled mb-0 small">
                                                <% registros[usuario.id].forEach(r => { %>
                                                    <li class="mb-1 d-flex justify-content-between align-items-center border-bottom pb-1">
                                                        <span class="fw-bold text-secondary"><%= r.tipo %></span>
                                                        <span><%= new Date(r.timestamp).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' }) %></span>
                                                        <form action="/rh/registro-ponto/excluir/<%= r.id %>" method="POST" class="m-0 ms-2">
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Apagar" onclick="return confirm('Apagar este registo?')">×</button>
                                                        </form>
                                                    </li>
                                                <% }) %>
                                            </ul>
                                        <% } else { %>
                                            <span class="text-muted small fst-italic">Sem registros hoje.</span>
                                        <% } %>
                                    </td>
                                    <td class="fw-bold text-primary text-center">
                                        <%= horas[usuario.id] || '00h 00m' %>
                                    </td>
                                    <td>
                                        <form action="/rh/funcionario/<%= usuario.id %>/horario" method="POST" class="d-flex flex-column gap-1 m-0">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">Ent</span>
                                                <input type="time" name="horarioEntrada" class="form-control" value="<%= usuario.horarioEntrada || '09:00' %>" required>
                                            </div>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">Sai</span>
                                                <input type="time" name="horarioSaida" class="form-control" value="<%= usuario.horarioSaida || '18:00' %>" required>
                                            </div>
                                            <button type="submit" class="btn btn-outline-primary btn-sm w-100 mt-1">Guardar</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form action="/rh/funcionario/ferias" method="POST" class="d-flex flex-column gap-1 m-0">
                                            <input type="hidden" name="funcionarioId" value="<%= usuario.id %>">
                                            <input type="date" name="dataInicio" class="form-control form-control-sm" required>
                                            <input type="date" name="dataFim" class="form-control form-control-sm" required>
                                            <button type="submit" class="btn btn-outline-success btn-sm w-100 mt-1">Agendar</button>
                                        </form>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            <a href="/rh/registro-manual/<%= usuario.id %>" class="btn btn-secondary btn-sm fw-bold">✍️ Registo Manual</a>
                                            <div class="d-flex gap-2">
                                                <a href="/rh/funcionario/editar/<%= usuario.id %>" class="btn btn-primary btn-sm flex-grow-1 fw-bold">Editar</a>
                                                
                                                <% if (usuario.id !== userIdLogado) { %>
                                                    <form action="/rh/funcionario/deletar/<%= usuario.id %>" method="POST" class="m-0 flex-grow-1">
                                                        <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold" onclick="return confirm('ATENÇÃO! Tens a certeza que queres eliminar este funcionário?')">Eliminar</button>
                                                    </form>
                                                <% } else { %>
                                                    <button type="button" class="btn btn-secondary btn-sm flex-grow-1 fw-bold" disabled title="Você não pode se autoexcluir">Você</button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" class="text-center py-5 text-muted"><h4>Nenhum colaborador na equipa.</h4></td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>