<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Chronos Ponto Facial</title>
    <link rel="shortcut icon" href="/icon.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .navbar-chronos { background-color: #2c3e50; }
        .camera-box {
            background: #000; border-radius: 8px; overflow: hidden;
            position: relative; width: 100%; max-width: 320px;
            margin: 0 auto; min-height: 240px; display: flex;
            align-items: center; justify-content: center;
        }
        #video-preview {
            width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1);
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-chronos shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/dashboard">
                <img src="/icon.ico" alt="Logo Chronos" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos
            </a>
            <div class="d-flex">
                <form action="/logout" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-light btn-sm fw-bold">Sair</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <div class="mb-4 text-center">
                    <h2 class="text-dark fw-bold">Ponto Eletrônico</h2>
                    <% if (locals.user) { %>
                        <p class="text-muted">Olá, <strong><%= user.nome %></strong>!</p>
                    <% } %>
                </div>

                <% if (locals.query && query.mensagem === 'ciclo_finalizado') { %>
                    <div class="alert alert-warning text-center fw-bold">Você já completou as 4 batidas de ponto do dia!</div>
                <% } else if (locals.query && query.msg === 'ponto_registrado') { %>
                    <div class="alert alert-success text-center fw-bold">✅ Ponto registrado com sucesso!</div>
                <% } else if (locals.query && query.erro === 'foto_obrigatoria') { %>
                    <div class="alert alert-danger text-center fw-bold">📸 Você precisa permitir a câmera para bater o ponto!</div>
                <% } else if (locals.query && query.erro === 'falha_geral') { %>
                    <div class="alert alert-danger text-center fw-bold">❌ Ocorreu um erro ao enviar. Tente novamente.</div>
                <% } %>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body text-center">
                        <div class="camera-box shadow-sm mb-3">
                            <video id="video-preview" autoplay playsinline muted></video>
                            <div id="camera-erro-msg" class="text-white p-3" style="display: none; font-size: 14px;">
                                Aguardando permissão da câmera...
                            </div>
                        </div>
                        <canvas id="canvas-capture" style="display: none;"></canvas>
                        <form id="form-registrar-ponto">
                            <button id="btn-bater-ponto" type="submit" class="btn btn-success btn-lg w-100 fw-bold" disabled>
                                INICIANDO CÂMERA E GPS...
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-3">
                        <h5 class="mb-0 text-dark fw-bold">Seus registros de hoje</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <% if (registros && registros.length > 0) { %>
                                <% registros.forEach(registro => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                                        <span class="fw-bold text-secondary"><%= registro.tipo %></span>
                                        <span class="badge bg-light text-dark border fs-6">
                                            <%= new Date(registro.timestamp).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' }) %>
                                        </span>
                                    </li>
                                <% }) %>
                            <% } else { %>
                                <li class="list-group-item text-center text-muted py-4">Nenhum registro hoje.</li>
                            <% } %>
                        </ul>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="/meu_relatorio" class="btn btn-outline-secondary fw-bold">Ver meu extrato completo</a>
                    <% if (locals.user && user.role === 'rh') { %>
                        <a href="/rh/dashboard" class="btn btn-outline-primary mt-2 fw-bold">Acessar Área do RH</a>
                    <% } %>
                </div>

            </div>
        </div>
    </div>

    <script>
        const video = document.getElementById('video-preview');
        const canvas = document.getElementById('canvas-capture');
        const btnBaterPonto = document.getElementById('btn-bater-ponto');
        const formRegistrar = document.getElementById('form-registrar-ponto');
        const cameraErroMsg = document.getElementById('camera-erro-msg');
        let streamAtivo = null;

        async function iniciarCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } 
                });
                video.srcObject = stream;
                streamAtivo = stream;
                
                video.onloadedmetadata = () => {
                    video.play();
                    const urlParams = new URLSearchParams(window.location.search);
                    const cicloFinalizado = urlParams.get('mensagem') === 'ciclo_finalizado';
                    if (!cicloFinalizado) {
                        btnBaterPonto.disabled = false;
                        btnBaterPonto.textContent = 'BATER PONTO AGORA';
                    } else {
                        btnBaterPonto.textContent = 'CICLO DO DIA FINALIZADO';
                    }
                };
            } catch (err) {
                console.error("Erro na câmera:", err);
                video.style.display = 'none';
                cameraErroMsg.style.display = 'block';
                cameraErroMsg.textContent = 'Erro: Você precisa permitir a câmera no navegador para registrar o ponto.';
                btnBaterPonto.textContent = 'CÂMERA BLOQUEADA';
            }
        }

        iniciarCamera();

        // 📍 NOVO: Função para pegar a localização
        const getLocalizacao = () => new Promise((resolve) => {
            if (!navigator.geolocation) return resolve({ lat: null, lng: null });
            navigator.geolocation.getCurrentPosition(
                pos => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
                err => resolve({ lat: null, lng: null }), // Ignora erro para não travar a batida
                { enableHighAccuracy: true, timeout: 5000 }
            );
        });

        // 🚀 ATUALIZADO: Agora é async para esperar o GPS!
        formRegistrar.addEventListener('submit', async function(event) {
            event.preventDefault();
            if (btnBaterPonto.disabled) return;
            if (!confirm("Confirmar registro de ponto com foto e localização?")) return;

            btnBaterPonto.disabled = true;
            btnBaterPonto.textContent = '📍 Capturando localização...';

            // Aguarda o GPS
            const { lat, lng } = await getLocalizacao();

            btnBaterPonto.textContent = 'Processando IA Facial...';

            const larguraFinal = 320; 
            const escala = larguraFinal / video.videoWidth;
            const alturaFinal = video.videoHeight * escala;

            canvas.width = larguraFinal;
            canvas.height = alturaFinal;
  
            const ctx = canvas.getContext('2d');
            ctx.translate(canvas.width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob(function(blob) {
                const formData = new FormData();
                formData.append('foto', blob, 'selfie.jpg'); 
                
                // 📍 Injetando o GPS se existir
                if (lat && lng) {
                    formData.append('latitude', lat);
                    formData.append('longitude', lng);
                }

                fetch('/registrar', { method: 'POST', body: formData })
                .then(async response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }
                    if (!response.ok) {
                        const textoResposta = await response.text();
                        if (textoResposta.includes('<!DOCTYPE html>')) {
                            document.open();
                            document.write(textoResposta); document.close();
                        } else {
                            alert("Erro do Servidor: " + textoResposta);
                            btnBaterPonto.disabled = false; btnBaterPonto.textContent = 'TENTAR NOVAMENTE';
                        }
                    } else {
                        window.location.reload();
                    }
                })
                .catch(err => {
                    console.error("Erro no envio:", err);
                    alert("Erro de conexão ao enviar. Verifique sua internet.");
                    btnBaterPonto.disabled = false; btnBaterPonto.textContent = 'TENTAR NOVAMENTE';
                });
            }, 'image/jpeg', 0.6);
        });
    </script>
</body>
</html>