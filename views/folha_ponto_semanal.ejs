<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Folha de Ponto - Chronos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .navbar-chronos { background-color: #2c3e50; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-chronos shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/rh/dashboard">
                <img src="/icon.ico" alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos <span class="badge bg-light text-dark ms-2 fs-6">RH</span>
            </a>
            <a href="/rh/dashboard" class="btn btn-outline-light btn-sm fw-bold">← Voltar</a>
        </div>
    </nav>

    <div class="container-fluid px-4 py-4">
        <h2 class="fw-bold text-dark mb-4">📄 Folha de Ponto Semanal</h2>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body bg-light rounded">
                <form method="GET" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary">De:</label>
                        <input type="date" class="form-control" name="dataInicio" value="<%= dataInicioSelecionada %>" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary">Até:</label>
                        <input type="date" class="form-control" name="dataFim" value="<%= dataFimSelecionada %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary">Funcionário:</label>
                        <select name="funcionarioId" class="form-select" required>
                            <option value="">Selecione...</option>
                            <option value="todos" <%= funcionarioIdSelecionado == 'todos' ? 'selected' : '' %>>Todos os Funcionários</option>
                            <% listaFuncionarios.forEach(func => { %>
                                <option value="<%= func.id %>" <%= funcionarioIdSelecionado == func.id ? 'selected' : '' %>><%= func.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold">Filtrar</button>
                    </div>
                </form>
            </div>
        </div>

        <% if (relatorioAgrupado) { %>
            <div class="text-end mb-3">
                <a href="/rh/relatorios/folha-ponto/pdf?dataInicio=<%= dataInicioSelecionada %>&dataFim=<%= dataFimSelecionada %>&funcionarioId=<%= funcionarioIdSelecionado %>" 
                   class="btn btn-danger fw-bold shadow-sm">
                   📄 Baixar PDF Oficial
                </a>
            </div>
        <% } %>

        <% if (relatorioAgrupado && relatorioAgrupado.length > 0) { %>
            <% relatorioAgrupado.forEach(funcionario => { %>
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h4 class="mb-0 fw-bold text-primary">👤 <%= funcionario.nome %></h4>
                    </div>
                    <div class="card-body p-0">
                        <% funcionario.semanas.forEach(semana => { %>
                            <% const diasDaSemana = {segunda: 'Segunda', terca: 'Terça', quarta: 'Quarta', quinta: 'Quinta', sexta: 'Sexta'}; %>
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered mb-0 align-middle">
                                    <thead class="table-light text-secondary">
                                        <tr>
                                            <th width="15%">Dia</th>
                                            <th width="15%">Data</th>
                                            <th width="35%">Registros</th>
                                            <th width="10%" class="text-center">Total</th>
                                            <th width="10%" class="text-center">Saldo</th>
                                            <th width="15%">Obs</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% Object.keys(diasDaSemana).forEach(key => { %>
                                            <% const dia = semana[key]; %>
                                            <tr>
                                                <td class="fw-bold"><%= diasDaSemana[key] %></td>
                                                <% if (dia) { %>
                                                    <td><%= dia.data.toLocaleDateString('pt-BR') %></td>
                                                    <td>
                                                        <ul class="mb-0 ps-3">
                                                        <% dia.registros.forEach(r => { %>
                                                            <li><span class="badge bg-secondary"><%= r.tipo %></span> <%= new Date(r.timestamp).toLocaleTimeString('pt-BR', {timeZone: 'America/Sao_Paulo' }) %></li>
                                                        <% }) %>
                                                        </ul>
                                                    </td>
                                                    <td class="text-center fw-bold"><%= dia.horasTrabalhadas %></td>
                                                    <td class="text-center fw-bold <%= dia.saldoHoras.startsWith('+') ? 'text-success' : 'text-danger' %>"><%= dia.saldoHoras %></td>
                                                    <td class="fw-bold <%= dia.observacao === 'Falta' ? 'text-danger' : (dia.observacao === 'Férias' ? 'text-primary' : '') %>"><%= dia.observacao %></td>
                                                <% } else { %>
                                                    <td colspan="5" class="bg-light"></td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        <% } else if (funcionarioIdSelecionado) { %>
            <div class="alert alert-info text-center fw-bold">Nenhum dado encontrado para o período.</div>
        <% } %>
    </div>
</body>
</html>