<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Super Admin - Chronos SaaS</title>
    <link rel="shortcut icon" href="/icon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body { background-color: #f4f6f9; }
        .navbar-chronos { background-color: #2c3e50; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-chronos shadow-sm mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/superadmin/dashboard">
                <img src="/icon.ico" alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos <span class="badge bg-danger ms-2 fs-6 shadow-sm">SUPER ADMIN</span>
            </a>
            <div class="d-flex">
                <form action="/logout" method="POST" class="m-0">
                    <button type="submit" class="btn btn-outline-light btn-sm fw-bold">Sair</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <h2 class="fw-bold text-dark mb-4">Gestão de Clientes SaaS</h2>

        <% if (typeof query !== 'undefined' && query.msg === 'empresa_manual_ok') { %>
            <div class="alert alert-success fw-bold shadow-sm">✅ Cliente Enterprise cadastrado e ativado com sucesso!</div>
        <% } %>

        <button type="button" class="btn btn-primary fw-bold mb-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalEnterprise">
            + Cadastrar Cliente Enterprise/Manual
        </button>

        <div class="modal fade" id="modalEnterprise" tabindex="-1">
            <div class="modal-dialog">
                <form action="/superadmin/empresa/manual" method="POST" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Novo Cliente Customizado</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-bold">Nome da Empresa</label>
                            <input type="text" name="nomeEmpresa" class="form-control" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-secondary fw-bold">E-mail Admin</label>
                                <input type="email" name="emailAdmin" class="form-control" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-secondary fw-bold">Senha Inicial</label>
                                <input type="text" name="senhaAdmin" class="form-control" value="Mudar123" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary fw-bold">Limite Func.</label>
                                <input type="number" name="limite" class="form-control" value="80" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary fw-bold">Valor (R$)</label>
                                <input type="number" step="0.01" name="valor" class="form-control" value="450.00" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label text-secondary fw-bold">Dias Acesso</label>
                                <input type="number" name="diasVencimento" class="form-control" value="30" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-bold">Nome do Plano <small>(ex: Enterprise, Parceiro)</small></label>
                            <input type="text" name="planoNome" class="form-control" placeholder="enterprise">
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn btn-success fw-bold w-100">Criar Empresa e Liberar Acesso</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bg-white">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Empresa / CNPJ</th>
                            <th>Plano & Financeiro</th>
                            <th>Uso (Cadastrados/Limite)</th>
                            <th>Status (Acesso)</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% empresas.forEach(empresa => { %>
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#<%= empresa.id %></td>
                                <td>
                                    <div class="fw-bold text-dark"><%= empresa.nome %></div>
                                    <div class="text-muted small"><%= empresa.cnpj || 'Sem CNPJ' %></div>
                                </td>
                                <td>
                                    <span class="badge bg-primary text-uppercase"><%= empresa.plano || 'Starter' %></span>
                                    <div class="text-muted small mt-1">Mensal: R$ <%= (empresa.valorMensalidade || 49.90).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <% const usoPorcentagem = Math.min((empresa.Users.length / (empresa.limiteFuncionarios || 5)) * 100, 100); %>
                                            <div class="progress-bar <%= usoPorcentagem > 90 ? 'bg-danger' : 'bg-success' %>" style="width: <%= usoPorcentagem %>%;"></div>
                                        </div>
                                        <span class="small fw-bold"><%= empresa.Users.length %> / <%= empresa.limiteFuncionarios || 5 %></span>
                                    </div>
                                </td>
                                <td>
                                    <% if (empresa.ativo) { %>
                                        <span class="badge bg-success px-3 py-2 shadow-sm">Ativo</span>
                                    <% } else { %>
                                        <span class="badge bg-danger px-3 py-2 shadow-sm">Bloqueado</span>
                                    <% } %>
                                </td>
                                <td class="pe-4 text-end">
                                    <% if (empresa.id !== 1) { %>
                                        <form action="/superadmin/empresa/<%= empresa.id %>/toggle-status" method="POST" class="m-0">
                                            <% if (empresa.ativo) { %>
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold shadow-sm" onclick="return confirm('Bloquear o acesso desta empresa? Ninguém mais poderá bater ponto.')">Bloquear</button>
                                            <% } else { %>
                                                <button type="submit" class="btn btn-success btn-sm fw-bold shadow-sm">Liberar</button>
                                            <% } %>
                                        </form>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted border">Matriz</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>