<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Dados da Empresa - Chronos</title>
    <link rel="shortcut icon" href="/icon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; }
        .navbar-chronos { background-color: #2c3e50; }
        .logo-preview { max-width: 150px; max-height: 150px; object-fit: contain; border: 1px solid #ddd; border-radius: 8px; padding: 5px; background: #fff;}
    </style>
</head>
<body>
    
    <nav class="navbar navbar-expand-lg navbar-dark navbar-chronos shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/rh/dashboard">
                <img src="/icon.ico" alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2 rounded">
                Chronos <span class="badge bg-light text-dark ms-2 fs-6 shadow-sm">RH</span>
            </a>
            <a href="/rh/dashboard" class="btn btn-outline-light btn-sm fw-bold shadow-sm">← Voltar</a>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <% if (locals.query) { %>
                    <% if (query.msg === 'dados_salvos') { %>
                        <div class="alert alert-success fw-bold shadow-sm">✅ Dados da empresa atualizados com sucesso!</div>
                    <% } %>
                    <% if (query.msg === 'logo_atualizada') { %>
                        <div class="alert alert-success fw-bold shadow-sm">🖼️ Logo atualizada com sucesso!</div>
                    <% } %>
                    <% if (query.erro === 'nome_vazio') { %>
                        <div class="alert alert-danger fw-bold shadow-sm">⚠️ O nome da empresa não pode ficar vazio.</div>
                    <% } %>
                <% } %>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold text-dark mb-3">Logo da Empresa</h5>
                        <div class="mb-3">
                            <% if (empresa && empresa.logoPath) { %>
                                <img src="<%= empresa.logoPath %>" alt="Logo da Empresa" class="logo-preview shadow-sm">
                            <% } else { %>
                                <div class="text-muted p-4 border rounded bg-light" style="display: inline-block;">Sem Logo Cadastrada</div>
                            <% } %>
                        </div>
                        
                        <form action="/rh/empresa/logo" method="POST" enctype="multipart/form-data" class="d-flex flex-column align-items-center">
                            <input type="file" name="logo" class="form-control mb-3 w-75" accept="image/*" required>
                            <button type="submit" class="btn btn-secondary fw-bold w-75 shadow-sm">Atualizar Logo</button>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Informações Gerais</h5>
                        
                        <form action="/rh/empresa/editar" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Nome da Empresa</label>
                                <input type="text" name="nome" class="form-control" value="<%= empresa ? empresa.nome : '' %>" required>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">CNPJ</label>
                                <input type="text" name="cnpj" class="form-control" value="<%= empresa && empresa.cnpj ? empresa.cnpj : '' %>" placeholder="Opcional">
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary">IPs Permitidos para Bater Ponto</label>
                                <textarea name="allowedIps" class="form-control bg-light" rows="3" placeholder="Ex: 192.168.1.1, 200.10.20.5"><%= typeof allowedIps !== 'undefined' ? allowedIps : '' %></textarea>
                                <div class="form-text mt-2">Um IP por linha ou separados por vírgula. Deixe em branco para desativar a restrição de IP.</div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">Salvar Alterações</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>